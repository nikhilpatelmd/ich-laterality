@article{parthasarathyPatientStakeholderEngagement2025,
  title = {Patient--{{Stakeholder Engagement}} for {{Patient-Centered Research}} on {{Sleep Apnea}}},
  author = {Parthasarathy, Sairam and Frydman, Gilles},
  editor = {Sacks, Chana A.},
  year = 2025,
