  title = {Sodium {{Bicarbonate}} for {{Severe Metabolic Acidemia}} and {{Acute Kidney Injury}}: {{The BICARICU-2 Randomized Clinical Trial}}},
  shorttitle = {Sodium {{Bicarbonate}} for {{Severe Metabolic Acidemia}} and {{Acute Kidney Injury}}},
  author = {Jung, Boris and Jabaudon, Mathieu and De Jong, Audrey and Bitker, Laurent and Audard, Jules and Klouche, Kada and Sarton, Benjamine and Guitton, Christophe and Lasocki, Sigismond and Rieu, Benjamin and Canet, Emmanuel and Jeantrelle, Caroline and Roquilly, Antoine and Mayaux, Julien and Verdonk, Franck and Pottecher, Julien and Ferrandiere, Martine and Riu, Beatrice and Garcon, Pierre and Assefi, Mona and Detouche, Philippe and Forel, Jean Marie and Roger, Claire and Bourenne, Jeremy and Jacquier, Sophie and Bougon, David and Rolle, Amelie and Corne, Philippe and Benchabane, Nacim and Richard, Jean Christophe and Asehnoune, Karim and Chanques, Gerald and Reignier, Jean and Belafia, Foud and Fosset, Maxime and Huguet, Helena and Futier, Emmanuel and Molinari, Nicolas and Jaber, Samir and {BICARICU-2 Study Group} and Machado, Sonia and Brunot, Vincent and Platon, Laura and Daubin, Delphine and Besnard, No{\'e}mie and Moulaire, Val{\'e}rie and Pelle, Corinne and Landreau, Liliane and Deneil, Guillaume and Yonis, Hodane and Mezidi, Mehdi and Chauvelot, Louis and Silva, Stein and Tirot, Patrice and Darreau, Cedric and Chudeau, Nicolas and Campfort, Maeva and Gergaud, Soizic and Giordanetto, Loris and Godet, Thomas and Lascarrou, Jean Baptiste and Reignier, Jean and Giabicani, Mikahel and Ashenoune, Karim and Hourmant, Yannick and Bourdiol, Alexre and Poulain, C{\'e}cile and Demoule, Alexre and Dres, Martin and Decav{\`e}le, Maxens and Lecronier, Marie and Bureau, C{\^o}me and Do Vale, Julien and Menat, Sophie and Clerc, Sebastien and Pichon, Jeremie and Catano, Jennifer and Celier, Adam and Le Stang, Valentine and Diemoz, Marie-Claire and {Flis-Richard}, Hugo and Pardo, Emmanuel and Kapandji, Natacha and Meyer, Alain and Hecketsweiler, Stephane and Selim Abback, Paer and Vong, Ly Van Phach and Reitter, Delphine and Zarka, Jonathan and Constantin, Jean Michel and Daviet, Florence and Muller, Laurent and Lefrant, Jean Yves and Ehrmann, Stephan and Salmon Ginniere, Charlotte and Bodet Contentin, Laetitia and Carvelli, Julien and Gainier, Marc and Cholley, Bernard and Dellamonica, Jean and Jozwiak, Mathieu and Sacchieri, Clement and Lautrette, Alexandre and Cour, Martin and Argaud, Laurent and Rimmele, Thomas and Preau, Sebastien and Capdevila, Xavier and Fiancette, Maud and Roux, Damien and Bohe, Julien and Asfar, Pierre and Chabanne, Russel and Terzi, Nicolas and Bige, Na{\"i}ke and Garnero, Aude and Mokart, Djamel and Kallel, Hatem},
  year = 2025,
  month = dec,
  journal = {JAMA},
  volume = {334},
  number = {22},
  pages = {2000},
  issn = {0098-7484},
  doi = {10.1001/jama.2025.20231},
  urldate = {2025-12-11},
  abstract = {OBJECTIVE To determine whether sodium bicarbonate infusion is associated with day 90 all-cause mortality in patients with severe metabolic acidemia and moderate to severe acute kidney injury. DESIGN, SETTING, AND PARTICIPANTS Randomized, open-label, clinical trial conducted with 640 patients in 43 French intensive care units from October 6, 2019, to December 19, 2023, with 90-day follow-up. The last date of follow-up was June 17, 2024. Adults with severe metabolic acidemia (defined as pH 7.20) and moderate to severe acute kidney injury were enrolled. INTERVENTION Patients were randomized 1:1 to receive either intravenous sodium bicarbonate infusion or no sodium bicarbonate to target an arterial pH of 7.30 or higher. MAIN OUTCOMES AND MEASURES The primary outcome was day 90 all-cause mortality. Secondary outcomes included day 28 and day 180 all-cause mortality; use of organ support therapy, vasopressors, or invasive mechanical ventilation; intensive care unit and hospital length of stay; intensive care unit--acquired infections; fluid balance; day-7 Sequential [Sepsis-related] Organ Failure Assessment score (6 organ systems' function is evaluated and scored from 0 [no dysfunction] to 4 [failure]; total score ranges from 0 [normal] to 24 [maximum failure]); and major adverse kidney events on day 90. RESULTS Among 640 randomly assigned patients, 627 were analyzed (313 in the control group and 314 in the bicarbonate group). The median age was 67 years (IQR, 59-74 years); 194 of 314 patients (62\%) in the bicarbonate group and 185 of 313 controls (59\%) were male. In the primary analysis, day 90 all-cause mortality was 195 of 314 patients (62.1\%) in the bicarbonate group and 193 of 313 (61.7\%) in the control group (absolute difference, 0.4; 95\% CI, -7.2 to 8.0; P = .91). There was no evidence of a group effect on day 28 or day 180 all-cause mortality. Among 18 secondary outcomes, kidney replacement therapy was used in 109 of 314 (35\%) bicarbonate group patients and 157 of 313 (50\%) controls (absolute difference, -15.5; 95\% CI, -23.1 to -7.8). No evidence of a group effect was found on other secondary outcomes, including adverse events. CONCLUSIONS AND RELEVANCE For patients with severe metabolic acidemia and moderate to severe acute kidney injury, intravenous sodium bicarbonate did not affect mortality.},
