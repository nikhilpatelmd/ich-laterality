@article{ibanezBetaBlockersMyocardialInfarction2025,
  title = {Beta-{{Blockers}} after {{Myocardial Infarction}} without {{Reduced Ejection Fraction}}},
  author = {Ibanez, Borja and Latini, Roberto and Rossello, Xavier and {Dominguez-Rodriguez}, Alberto and {Fern{\'a}ndez-Vazquez}, Felipe and Pelizzoni, Valentina and S{\'a}nchez, Pedro L. and Anguita, Manuel and Barrab{\'e}s, Jos{\'e} A. and {Raposeiras-Roub{\'i}n}, Sergio and Pocock, Stuart and Escalera, Noem{\'i} and Staszewsky, Lidia and {P{\'e}rez-Garc{\'i}a}, Carlos Nicol{\'a}s and {D{\'i}ez-Villanueva}, Pablo and {P{\'e}rez-Rivera}, Jose-Angel and {Prada-Delgado}, Oscar and Owen, Ruth and Pizarro, Gonzalo and Caldes, Onofre and {G{\'o}mez-Talavera}, Sandra and Tu{\~n}{\'o}n, Jos{\'e} and Bianco, Matteo and Zarauza, Jesus and Vetrano, Alfredo and Campos, Ana and {Mart{\'i}nez-Huertas}, Susana and Bueno, H{\'e}ctor and Puentes, Miguel and Grigis, Giulietta and {Bonilla-Palomas}, Juan L. and Marco, Elvira and {Gonz{\'a}lez-Juanatey}, Jos{\'e} R. and Bangueses, Roi and {Gonz{\'a}lez-Juanatey}, Carlos and {Garc{\'i}a-{\'A}lvarez}, Ana and {Ruiz-Garc{\'i}a}, Juan and Carrasquer, Anna and {Garc{\'i}a-Rubira}, Juan C. and {Pascual-Figal}, Domingo and {Tom{\'a}s-Querol}, Carlos and San Rom{\'a}n, J. Alberto and Baratta, Pasquale and Ag{\"u}ero, Jaume and {Mart{\'i}n-Reyes}, Roberto and Colivicchi, Furio and {Ortas-Nadal}, Rosario and Bazal, Pablo and Cordero, Alberto and {Fern{\'a}ndez-Ortiz}, Antonio and Basso, Pierangelo and Gonz{\'a}lez, Eva and Poletti, Fabrizio and Bugani, Giulia and Debiasio, Marzia and Cosmi, Deborah and Navazio, Alessandro and Bermejo, Javier and Tortorella, Giovanni and Marini, Marco and Botas, Javier and {De La Torre-Hern{\'a}ndez}, Jos{\'e} M. and Ottani, Filippo and Fuster, Valent{\'i}n},
  year = 2025,
  month = nov,
  journal = {New England Journal of Medicine},
  volume = {393},
  number = {19},
  pages = {1889--1900},
  issn = {0028-4793, 1533-4406},
  doi = {10.1056/NEJMoa2504735},
  urldate = {2025-12-11},
  abstract = {BACKGROUND Current guideline recommendations for the use of beta-blockers after myocardial infarction without reduced ejection fraction are based on trials conducted before routine reperfusion, invasive care, complete revascularization, and contemporary pharmacologic therapies became standard practice. METHODS We conducted an open-label, randomized trial in Spain and Italy to evaluate the effect of beta-blocker therapy, as compared with no beta-blocker therapy, in patients with acute myocardial infarction (with or without ST-segment elevation) and a left ventricular ejection fraction above 40\%. The primary outcome was a composite of death from any cause, reinfarction, or hospitalization for heart failure. RESULTS In total, 4243 patients were randomly assigned to receive beta-blocker therapy and 4262 to receive no beta-blocker therapy; after exclusions, 8438 patients were included in the main analysis. During a median follow-up of 3.7 years, a primary-outcome event occurred in 316 patients (22.5 events per 1000 patient-years) in the beta-blocker group and in 307 patients (21.7 events per 1000 patient-years) in the no-beta-blocker group (hazard ratio, 1.04; 95\% confidence interval [CI], 0.89 to 1.22; P=0.63). Death from any cause occurred in 161 patients and 153 patients, respectively (11.2 vs. 10.5 events per 1000 patient-years; hazard ratio, 1.06; 95\% CI, 0.85 to 1.33); reinfarction in 143 patients and 143 patients (10.2 vs. 10.1 events per 1000 patient-years; hazard ratio, 1.01; 95\% CI, 0.80 to 1.27); and hospitalization for heart failure in 39 patients and 44 patients (2.7 vs. 3.0 events per 1000 patient-years; hazard ratio, 0.89; 95\% CI, 0.58 to 1.38). No apparent between-group differences in safety outcomes were noted. CONCLUSIONS Among patients discharged after invasive care for a myocardial infarction with a left ventricular ejection fraction above 40\%, beta-blocker therapy appeared to have no effect on the incidence of death from any cause, reinfarction, or hospitalization for heart failure. (Funded by Centro Nacional de Investigaciones Cardiovasculares Carlos III and others; ClinicalTrials.gov number, NCT03596385; EudraCT number, 2017-002485-40.) ABSTR ACT},
