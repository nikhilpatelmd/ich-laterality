@article{qureshiOutcomesIntensiveSystolic2020,
  title = {Outcomes of {{Intensive Systolic Blood Pressure Reduction}} in {{Patients With Intracerebral Hemorrhage}} and {{Excessively High Initial Systolic Blood Pressure}}: {{Post Hoc Analysis}} of a {{Randomized Clinical Trial}}},
  shorttitle = {Outcomes of {{Intensive Systolic Blood Pressure Reduction}} in {{Patients With Intracerebral Hemorrhage}} and {{Excessively High Initial Systolic Blood Pressure}}},
  author = {Qureshi, Adnan I. and Huang, Wei and Lobanova, Iryna and Barsan, William G. and Hanley, Daniel F. and Hsu, Chung Y. and Lin, Cheng-Li and Silbergleit, Robert and Steiner, Thorsten and Suarez, Jose I. and Toyoda, Kazunori and Yamamoto, Haruko and {for ATACH-II trial investigators}},
  year = 2020,
  month = nov,
  journal = {JAMA Neurology},
  volume = {77},
  number = {11},
  pages = {1355--1365},
  issn = {2168-6149},
  doi = {10.1001/jamaneurol.2020.3075},
  urldate = {2026-04-01},
  abstract = {The safety and efficacy of intensive systolic blood pressure reduction in patients with intracerebral hemorrhage who present with systolic blood pressure greater than 220 mm Hg appears to be unknown.To evaluate the differential outcomes of intensive (goal, 110-139 mm Hg) vs standard (goal, 140-179 mm Hg) systolic blood pressure reduction in patients with intracerebral hemorrhage and initial systolic blood pressure of 220 mm Hg or more vs less than 220 mm Hg.This post hoc analysis of the Antihypertensive Treatment of Acute Cerebral Hemorrhage-II trial was performed in November 2019 on data from the multicenter randomized clinical trial, which was conducted between May 2011 to September 2015. Patients with intracerebral hemorrhage and initial systolic blood pressure of 180 mm Hg or more, randomized within 4.5 hours after symptom onset, were included.Intravenous nicardipine infusion titrated to goals.Neurological deterioration and hematoma expansion within 24 hours and death or severe disability at 90 days, plus kidney adverse events and serious adverse events until day 7 or hospital discharge.A total of 8532 patients were screened, and 999 individuals (mean [SD] age, 62.0 [13.1] years; 620 men [62.0\%]) underwent randomization and had an initial SBP value. Among 228 participants with initial systolic blood pressures of 220 mm Hg or more, the rate of neurological deterioration within 24 hours was higher in those who underwent intensive (vs standard) systolic blood pressure reduction (15.5\% vs 6.8\%; relative risk, 2.28 [95\% CI, 1.03-5.07]; P\,=\,.04). The rate of death and severe disability (39.0\% vs 38.4\%; relative risk, 1.02 [95\% CI, 0.73-1.78]; P\,=\,.92) was not significantly different between the 2 groups. There was a significantly higher rate of kidney adverse events in participants randomized to intensive systolic blood pressure reduction (13.6\% vs 4.2\%; relative risk, 3.22 [95\% CI, 1.21-8.56]; P\,=\,.01), but no difference was observed in the rate of kidney serious adverse events.The higher rate of neurological deterioration within 24 hours associated with intensive treatment in patients with intracerebral hemorrhage and initial systolic blood pressure of 220 mm Hg or more, without any benefit in reducing hematoma expansion at 24 hours or death or severe disability at 90 days, warrants caution against generalization of recommendations for intensive systolic blood pressure reduction.},
  file = {/home/nikhil/Zotero/storage/3GF9BYLL/2020 Outcomes of Intensive Systolic Blood Pressure Reduction in Patients With Intracerebral Hemorrhage an Qureshi et al..pdf}
}

@article{rahimovCommonDiseasesClinical2025,
  title = {Common {{Diseases}} in {{Clinical Cohorts}} --- {{Not Always What They Seem}}},
  author = {Rahimov, Fedik and Jacobs, Benjamin M. and Lee, John S. and Mahi, Naim A. and Blumenfeld, Andrew and Alsheikh, Ammar J. and Abbasi, Ali and Reppell, Mark and Pivorunas, Valerie L. and Sigur{\dh}sson, Haukur J. and Sawcer, Stephen and Guay, Heath and Waring, Jeffrey F. and Jacob, Howard J. and Smaoui, Nizar},
  year = 2025,
  month = oct,
  journal = {New England Journal of Medicine},
  volume = {393},
  number = {16},
  pages = {1589--1598},
  issn = {0028-4793, 1533-4406},
  doi = {10.1056/NEJMoa2405459},
  urldate = {2025-12-11},
  abstract = {BACKGROUND Misdiagnosis or underdiagnosis of rare diseases in patients with diagnoses of common diseases can lead to delayed or inappropriate treatments, thereby complicating the management of both rare and common conditions. Despite advances in molecular diagnostic techniques, the effect of rare diseases on the diagnosis of common diseases in research and clinical trials has not been comprehensively investigated. METHODS We used exome- and genome-sequencing data from participants in the U.K. Biobank, a research study, and five clinical trials involving patients who had received a primary diagnosis of multiple sclerosis, inflammatory bowel disease, or atopic dermatitis to assess the incidence of monogenic rare diseases that often manifest with clinical symptoms overlapping with those of these common diseases. RESULTS We identified 153 U.K. Biobank participants who carried a rare variant that contributes to a molecular diagnosis of a monogenic disorder --- 53 of 1850 (2.86\%) with a diagnosis of multiple sclerosis, 75 of 6681 (1.12\%) with a diagnosis of inflammatory bowel disease, and 25 of 998 (2.50\%) with a diagnosis of atopic dermatitis. We replicated the findings regarding such rare disease--causing variants in two independent cohorts --- one including patients with a diagnosis of multiple sclerosis, and the other patients with a diagnosis of inflammatory bowel disease --- who had undergone genome sequencing for research and for clinical trials, respectively. By combining genome and transcriptome analyses, we showed that molecular diagnosis can potentially elucidate mechanisms of inadequate response to therapeutic intervention. CONCLUSIONS Our study shows the value of systematic genome sequencing in understanding the phenotypic heterogeneity of common diseases and identifying failure to diagnose rare diseases and highlights the benefits of deep molecular phenotyping in clinical trials and patient care. (Funded by AbbVie and NIHR Cambridge Biomedical Research Centre.)},
  copyright = {http://www.nejmgroup.org/legal/terms-of-use.htm},
  langid = {english},
  keywords = {Unread},
  file = {/home/nikhil/Zotero/storage/PBWUW2YW/2025 Common Diseases in Clinical Cohorts — Not Always What They Seem Rahimov et al..pdf}
}

