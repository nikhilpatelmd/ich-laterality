  title = {Intravenous {{Rehydration}} for {{Severe Acute Malnutrition}} with {{Gastroenteritis}}},
  author = {Maitland, Kathryn and Ouattara, San Maurice and Sainna, Hadiza and Chara, Abdullahi and Ogundipe, Oluwakemi F. and Sunyoto, Temmy and Hamaluba, M. and {Olupot-Olupot}, Peter and Alaroker, Florence and Connon, Roisin and Saidou Maguina, Amadou and Okiror, William and Amorut, Denis and Mwajombo, Eric and Oguda, Emmanuel and Mogaka, Christabel and Langendorf, C{\'e}line and Dewez, Juan Emmanuel and Ciglenecki, Iza and Gibb, Diana M. and Coldiron, Matthew E. and Petrucci, Roberta and George, Elizabeth C.},
